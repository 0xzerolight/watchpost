# Data and local state
data/*.db*
*.bak

# Environment variables (may contain API keys)
.env
.env.*
!.env.example

# Rust
/target/
**/*.rs.bk

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Claude / AI tooling
.claude/
.claude-runner/

# Build / lint caches
.llvm-cov/
*.profraw

# extra
personal-docs/
.gstack/

# Private development docs (public docs live in repo root). The exception is the
# release notes, which ship: git cannot re-include a path under an excluded
# directory, so docs/ is excluded by its contents rather than as a whole.
docs/*
!docs/release_notes/
.superpowers

# Cargo.lock is deliberately NOT ignored: this is a binary crate, so the lock is
# committed for reproducible builds (same reason topic_watch commits its pinned
# requirements*.txt).

# Local compose overrides (machine-specific ports etc.)
docker-compose.override.yml
compose.override.yml
