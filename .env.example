# Copy to .env and fill in the token.

# Fine-grained personal access token with, under Repository permissions:
#   Metadata: read          — repository list and basic counts
#   Administration: read     — traffic views/clones/referrers/popular paths
# A classic token with `repo` also works. Without Administration: read the
# traffic endpoints return 403 and the charts stay empty.
WATCHPOST_GITHUB_TOKEN=

# Optional overrides — defaults shown.
#WATCHPOST_CRON=0 5 * * * *          # six fields (seconds first), UTC
#WATCHPOST_HOST=127.0.0.1            # the image sets 0.0.0.0
#WATCHPOST_PORT=8080
#WATCHPOST_LOG=info                  # tracing EnvFilter, e.g. watchpost=debug
#WATCHPOST_DB_PATH=./data/watchpost.db
