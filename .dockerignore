# Keep the build context small: the image builds from source inside the
# builder stage and needs nothing else.
target/
data/
.git/
.github/
.claude/
.superpowers/
docs/
tests/
.env
*.md
# README artwork: `COPY assets` feeds the builder, and nothing in the binary
# embeds this one, so it would only invalidate that layer whenever it changes.
assets/screenshot.png
